        layer eventos (
            name: EVENTOS
            layout {
                sequence: 80
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    /*
                    Lovs:
                    --EVENTOS_TIPO
                    --EVENTOS_ESTADOS
                    */
                    
                    select ID,
                           FO_ID,
                           lov_tipo.display_value DISPLAY_TIPO_EVENTO,
                           TIPO_FALLA,
                           ESTADO,
                           CRITICIDAD,
                           LON,
                           LAT,
                           FECHA_INICIO,
                           FECHA_FIN,
                           CREADO_POR,
                           CREADO_EL,
                           MODIFICADO_POR,
                           MODIFICADO_EL,
                           COMENTARIOS
                      from SGT_EVENTOS_FO
                       
                       join  apex_application_lov_entries lov_tipo on lov_tipo.return_value = TIPO_EVENTO
                    
                    
                     WHERE APPLICATION_ID = :APP_ID 
                       AND LIST_OF_VALUES_NAME = 'EVENTOS_TIPO'
                       --and estado = 1
                       and
                       ID = :P1_EVENTO_ID
                    ```
                pageItemsToSubmit: P1_EVENTO_ID
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LON
                latitudeColumn: LAT
                primaryKeyColumn: ID
            }
            pointObjects {
                shape: Square Alternative
            }
            appearance {
                fillColor: #f01111
            }
            tooltip {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    Tipo Evento: &DISPLAY_TIPO_EVENTO. <br/>
                    Tipo Falla: &TIPO_FALLA.<br/>
                    Crticidad: &CRITICIDAD.<br/>
                    Comentarios: &COMENTARIOS. <br/>
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 10
                    items: {
                        P10_ID: &ID.
                    }
                }
            }
        )

