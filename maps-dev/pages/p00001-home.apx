        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series series-1 (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select COUNT(ID),
                           
                           lov.DIsPLAY_VALUE "DISPLAY"
                           
                      from apex_application_lov_entries lov  
                    
                      join SGT_EVENTOS_FO efo on efo.tipo_evento = lov.return_value
                    
                     WHERE APPLICATION_ID = :APP_ID
                      
                    AND LIST_OF_VALUES_NAME = 'EVENTOS_TIPO'
                    group by lov.DIsPLAY_VALUE
                    ```
            }
            columnMapping {
                label: DISPLAY
                value: COUNT(ID)
            }
            label {
                show: true
            }
        )

    )

    region eventos-2 (
        name: Reporte
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ef.FO_ID,
                       TIPO_EVENTO,
                       TIPO_FALLA,
                       CRITICIDAD,
                       COMENTARIOS,
                       ESTADO,
                       LON,
                       LAT,
                       FECHA_INICIO,
                       FECHA_FIN,
                       CREADO_POR,
                       CREADO_EL,
                       MODIFICADO_POR,
                       MODIFICADO_EL,
                       srv.servicios,
                       wan.enlaces_wan
                      
                  from SGT_EVENTOS_FO ef
                
                  --ver todos los servicios que dependen de este evento
                  LEFT JOIN (
                    SELECT es.fo_id,
                           LISTAGG(DISTINCT s.nombre, ', ')
                             WITHIN GROUP (ORDER BY s.nombre) servicios
                    FROM sgt_equipos_servicio es
                    JOIN sgt_servicios s
                      ON s.id = es.servicio_id
                    GROUP BY es.fo_id
                ) srv ON srv.fo_id = ef.fo_id
                
                --VER TODOS LOS ENLACES WAN QUE DEPENDE DE LA FIBRA
                LEFT JOIN (
                    SELECT ew.fo_id,
                           LISTAGG(DISTINCT w.nombre, ', ')
                             WITHIN GROUP (ORDER BY w.nombre) enlaces_wan
                    FROM sgt_equipos_wan ew
                    JOIN sgt_enlaces_wan w
                      ON w.id = ew.wan_id
                    GROUP BY ew.fo_id
                ) wan ON wan.fo_id = ef.fo_id
                
                --where estado = 3
                WHERE :P1_ESTADO IS NULL OR ESTADO = :P1_ESTADO
                ```
            pageItemsToSubmit: P1_ESTADO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                type: url
                url: javascript:showFeature('#ID#')
            }
            linkIcon: <span class="t-Icon fa fa-lg fa-map-marker-s u-danger-text" aria-hidden="true"></span>
        }
