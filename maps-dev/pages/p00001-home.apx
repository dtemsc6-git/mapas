    region new_1 (
        name: TOTAL_FALLAS
        title: Top 5 con más fallas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COUNT (ID) Total,
                       FO_ID Fibra
                         from SGT_EVENTOS_FO
                
                         where SGT_EVENTOS_FO.estado = '1'
                
                  group by FO_ID
                ```
        }
        layout {
            sequence: 40
            parentRegion: @resumen-fallas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 11405152230076912
        }

        column FIBRA (
            type: plainTextBasedOnLov
            heading {
                heading: Fibra
                alignment: end
            }
            lov {
                lov: @fo-nombres
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column TOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Top 5 con más fallas
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 10
            }

            displayColumn FIBRA (
                sequence: 1
            )

            displayColumn TOTAL (
                sequence: 2
            )

            sort (
                column: TOTAL
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

