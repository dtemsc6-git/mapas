    region mapa-interactivo (
        name: MAPA_INTERACTIVO
        type: map
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Consulta que devuelve los datos del trazado y la info de la tabla fo + servicios + wan
                */
                
                select traza.ID,
                       traza.FO_ID,
                       L_NAME,
                       L_DESC,
                       SDO_DATA,
                       ef.nombre,
                    ef.cantidad_de_pelos,
                	
                    CASE 
                        WHEN ef.tipo_cable NOT IN ('ADSS', 'ARMORED', 'OPGW') THEN 'COMBINADOS'
                        ELSE ef.tipo_cable 
                    END  FILTRO_CABLE,
                    ef.tipo_cable, 
                    ef."CERTIFICACIÓN" CERT,
                
                     srv.servicios AS SERVICIOS,
                    WAN.ENLACES_WAN AS ENLACES_WAN
                     
                  from SGT_TRAZADOS_FO traza
                
                    --dmf: 2026-11-04: Ver todos los datos del trazado.
                   
                
                   
                
                join sgt_enlaces_fo ef on traza.fo_id = ef.id
                join sgt_sitios sa on ef.sitio_id_a = sa.id
                join sgt_sitios sb on ef.sitio_id_b = sb.id
                --dmf 2026-06-23: agregado para ver los servicios y enlaces wan
                --dmf 2026-06-23: agregado para ver los servicios y enlaces wan
                LEFT JOIN (
                    SELECT es.fo_id,
                           LISTAGG(DISTINCT s.nombre, ', ')
                             WITHIN GROUP (ORDER BY s.nombre) servicios
                    FROM sgt_equipos_servicio es
                    JOIN sgt_servicios s
                      ON s.id = es.servicio_id
                    GROUP BY es.fo_id
                ) srv ON srv.fo_id = ef.id
                
                --VER TODOS LOS ENLACES WAN QUE DEPENDE DE LA FIBRA
                LEFT JOIN (
                    SELECT ew.fo_id,
                           LISTAGG(DISTINCT w.nombre, ', ')
                             WITHIN GROUP (ORDER BY w.nombre) enlaces_wan
                    FROM sgt_equipos_wan ew
                    JOIN sgt_enlaces_wan w
                      ON w.id = ew.wan_id
                    GROUP BY ew.fo_id
                ) wan ON wan.fo_id = ef.id
                
                where  
                
                /*
                ( :P65_ZONAS is null
                or
                ef.sitio_id_a IN (select ID from sgt_sitios s where s.zona_id = :P65_ZONAS)
                or
                ef.sitio_id_b IN (select ID from sgt_sitios s where s.zona_id = :P65_ZONAS)
                )
                and (:P65_ENLACES_FO is null or ef.id = :P65_ENLACES_FO)
                
                --dmf 2026-06-23: agregado para ver los servicios y enlaces wan
                --Filtrar solo los troncales
                and */
                (ef.tipo = 'Troncal')
                
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
