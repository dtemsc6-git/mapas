page 8 (
    name: CEO_FORM
    alias: CEO-FORM
    title: Registro Elementos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ceo-form (
        name: CEO_FORM
        title: Registro Elementos
        type: form
        source {
            location: localDatabase
            tableName: SGT_CEO_ELEMENTOS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P8_CAPACIDAD (
        type: radioGroup
        label {
            label: Capacidad
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:24;24,36;36,72;72,144;144
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @ceo-form
            column: CAPACIDAD
            dataType: number
        }
    )

    pageItem P8_COD_COLUMNA (
        type: textField
        label {
            label: Cod Columna
            alignment: left
        }
        layout {
            sequence: 80
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @ceo-form
            column: COD_COLUMNA
            dataType: varchar2
        }
        help {
            inlineHelpText: Ingrese el cod columna, ej: CBO3_12345
        }
    )

    pageItem P8_COMENTARIOS (
        type: richTextEditor
        label {
            label: Comentarios
            alignment: left
        }
        settings {
            minHeight: 180
        }
        layout {
            sequence: 30
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @ceo-form
            column: COMENTARIOS
            dataType: clob
        }
    )

    pageItem P8_FO_ID (
        type: popupLov
        label {
            label: Fo Id
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select nombre, id from sgt_enlaces_fo
            displayExtraValues: false
            nullDisplayValue: Seleccione Una opción
        }
        layout {
            sequence: 20
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @ceo-form
            column: FO_ID
            dataType: number
        }
    )

    pageItem P8_ID (
        type: hidden
        layout {
            sequence: 10
            region: @ceo-form
            slot: regionBody
        }
        source {
            formRegion: @ceo-form
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P8_LAT (
        type: hidden
        layout {
            sequence: 110
            region: @ceo-form
            slot: regionBody
        }
        source {
            formRegion: @ceo-form
            column: LAT
            dataType: number
        }
    )

    pageItem P8_LON (
        type: hidden
        layout {
            sequence: 100
            region: @ceo-form
            slot: regionBody
        }
        source {
            formRegion: @ceo-form
            column: LON
            dataType: number
        }
    )

    pageItem P8_RESERVA_MTS (
        type: numberField
        label {
            label: Reserva
            alignment: left
        }
        settings {
            minValue: 1
            maxValue: 40
        }
        layout {
            sequence: 50
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @ceo-form
            column: RESERVA_MTS
            dataType: number
        }
        default {
            type: static
            staticValue: 40
        }
        help {
            inlineHelpText: Ingrese la reserva en metros
        }
    )

    pageItem P8_TIPO_ELEMENTO (
        type: radioGroup
        label {
            label: Tipo Elemento
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sharedComponent
            lov: @ceo-tipo-elemento
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @ceo-form
            column: TIPO_ELEMENTO
            dataType: number
        }
        default {
            type: static
            staticValue: 1
        }
    )

    pageItem P8_TIPO_MATERIAL (
        type: radioGroup
        label {
            label: Tipo Material
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Plástica;Plástica,Metálica;Metálica
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @ceo-form
            column: TIPO_MATERIAL
            dataType: varchar2
        }
    )

    pageItem P8_UBICACION (
        type: radioGroup
        label {
            label: Ubicacion
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sharedComponent
            lov: @ceo-ubicación
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @ceo-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @ceo-form
            column: UBICACION
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @ceo-form
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @ceo-form
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P8_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @ceo-form
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @ceo-form
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_ID
        }
    )

    dynamicAction new (
        name: TOOGLE
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P8_TIPO_ELEMENTO
        }
        clientSideCondition {
            type: item=value
            item: P8_TIPO_ELEMENTO
            value: 2
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P8_RESERVA_MTS
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide_1 (
            action: hide
            affectedElements {
                selectionType: items
                items: P8_CAPACIDAD
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P8_RESERVA_MTS
            }
            execution {
                sequence: 10
            }
        )

        action native-show_1 (
            action: show
            affectedElements {
                selectionType: items
                items: P8_CAPACIDAD
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction toogle-cod-columna (
        name: TOOGLE_COD_COLUMNA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P8_UBICACION
        }
        clientSideCondition {
            type: item=value
            item: P8_UBICACION
            value: Columna
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P8_COD_COLUMNA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P8_COD_COLUMNA
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p8-fo-id (
        itemName: P8_FO_ID
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                select fo_id from
                sgt_trazados_fo2 tf
                where sdo_nn( TF.SDO_DATA , mdsys.sdo_util.from_geojson (:P3_CLICK_POSICION ), 'distance=550 unit=m',   1 ) = 'TRUE'
                
                --select fo_id from sgt_trazados_fo2 tf where tf.id = :P3_TF_ID
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P8_FO_ID
        }
    )

    process initialize-form-ceo-form (
        name: Initialize form CEO_FORM
        type: formInitialization
        formRegion: @ceo-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11097039518181435
        }
    )

    process process-form-ceo-form (
        name: Process form CEO_FORM
        type: formAutoRowProcessing
        formRegion: @ceo-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11097427395181436
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 3
            }
        }
    )

)

