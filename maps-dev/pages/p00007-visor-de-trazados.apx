    region visor-de-trazados (
        name: EVENTOS_MAP_REGION
        title: Eventos
        type: map
        source {
            location: localDatabase
            tableName: SGT_TRAZADOS_FO2
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: eventos-map-region
        }
        map {
            height: 600
        }
        controls {
            options: rectangleZoom
        }
        attributes {
            messagesPosition: below
        }

        layer ceo (
            name: ceo
            layout {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                geometryColumn: SDO_DATA
                primaryKeyColumn: ID
            }
            tooltip {
                column: L_NAME
            }
            infoWindow {
                titleColumn: L_NAME
                bodyColumn: L_DESC
            }
            config {
                buildOption: @commented-out
            }
        )

        layer eventos (
            name: EVENTOS
            layout {
                sequence: 30
            }
            source {
                tableName: SGT_EVENTOS_FO
                whereClause: ID = :P7_ID
                pageItemsToSubmit: P7_ID
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LON
                latitudeColumn: LAT
                primaryKeyColumn: ID
            }
            infoWindow {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    <h3>Hola probando el info windows</h3>
                    <h3>Hola probando el info windows1</h3>
                    <h3>Hola probando el info windows2</h3>
                    <h3>Hola probando el info windows3</h3>
                    <h3>Hola probando el info windows4</h3>
                    ```
            }
        )

        layer visor-de-trazados (
            name: VISOR DE TRAZADOS
            layerType: lines
            layout {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                geometryColumn: SDO_DATA
                primaryKeyColumn: ID
            }
            appearance {
                strokeColor: #07b507
            }
            infoWindow {
                titleColumn: L_NAME
                bodyColumn: L_DESC
            }
        )

    )

    pageItem P7_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @visor-de-trazados
            slot: regionBody
        }
    )

    dynamicAction center-show (
        name: ShowFeature
        execution {
            sequence: 10
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @visor-de-trazados
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var lMapRegion   = apex.region("eventos-map-region"),
                        // important: Use the layer name exactly as specified in the "name" attribute in Page Designer
                        lLayerId     = lMapRegion.call("getLayerIdByName", "EVENTOS"),
                        lCurrentZoom = lMapRegion.call("getMapCenterAndZoomLevel").zoom,
                        leventoId    = apex.item("P7_ID").getValue(),
                        lFeature     = lMapRegion.call("getFeature", lLayerId, leventoId ),
                        lPosition;
                    
                       
                    
                    if ( lFeature.geometry ) {
                        lPosition    = lFeature.geometry.coordinates;
                            
                        // close all Info Windows, which might currently be open
                        lMapRegion.call( "closeAllInfoWindows" );
                    
                        // focus the map to the chosen feature
                        lMapRegion.call( "setCenter", lPosition );
                    
                        // if the current zoom level is below 8, zoom in. Otherwise do nothing.
                        if ( lCurrentZoom < 12 ) {
                            lMapRegion.call( "setZoomLevel", 12 );
                        }
                        setTimeout( function() {lMapRegion.call( "displayPopup", "infoWindow", lLayerId, leventoId.toString(), false )}, 500 );
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-center (
        name: refresh_center
        execution {
            sequence: 20
        }
        when {
            event: custom
            customEvent: refresh_and_center
            selectionType: jQuerySelector
            jquerySelector: #eventos-map-region
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @visor-de-trazados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

