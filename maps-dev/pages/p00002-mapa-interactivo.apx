page 2 (
    name: mapa-interactivo
    alias: MAPA-INTERACTIVO
    title: mapa-interactivo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: [
            https://unpkg.com/@watergis/maplibre-gl-terradraw@1.16.0/dist/maplibre-gl-terradraw.umd.js
            #APP_FILES#page2.js
            #APP_FILES#maps.js
        ]
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            /*const map = new maplibregl.Map({
              container: 'map-gl',
              // style: 'https://demotiles.maplibre.org/style.json', // Cambia por tu estilo Vector Tile
              style: 'https://tiles.openfreemap.org/styles/bright', // Cambia por tu estilo Vector Tile
              center: [-57.3332, -25.3332], // [Longitud, Latitud]
              zoom: 0
            });
            */
            ```
        executeWhenPageLoads: page2.init();
    }
    css {
        fileUrls: https://unpkg.com/@watergis/maplibre-gl-terradraw@1.16.0/dist/maplibre-gl-terradraw.css
        inline:
            ```css
            #map-gl {
                min-height: 600px;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region dialog-maker-elment (
        name: DIALOG_MAKER_ELMENT
        type: staticContent
        layout {
            sequence: 40
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: dialog-marker
        }
    )

    region dialog-map-element (
        name: DIALOG_MAP_ELEMENT
        type: staticContent
        layout {
            sequence: 30
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: dialog-guardar
        }
    )

    region mapa (
        name: Mapa
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: map-gl
        }
        config {
            buildOption: @commented-out
        }
    )

    region mapa-gl (
        name: MAPA
        type: map
        source {
            location: localDatabase
            tableName: SGT_TRAZADOS_FO
            whereClause: FO_ID = :P2_TRAZADO_ID
            pageItemsToSubmit: P2_TRAZADO_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: MAPA-GL
        }
        map {
            background: builtIn
            standard: openstreetmapBright
        }
        controls {
            options: [
                mousewheelZoom
                rectangleZoom
                scaleBar
                infiniteMap
            ]
        }
        attributes {
            messagesPosition: below
        }

        layer mapatrazados (
            name: MapaTrazados
            layerType: lines
            layout {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                geometryColumn: SDO_DATA
                primaryKeyColumn: ID
            }
            appearance {
                strokeColor: #101010
            }
        )

        layer puntos (
            name: Puntos
            layout {
                sequence: 20
            }
            source {
                location: regionSource
                useSpatialIndex: true
            }
            columnMapping {
                geometryColumn: SDO_DATA
                primaryKeyColumn: ID
            }
            tooltip {
                column: L_NAME
            }
        )

    )

    pageItem P2_COLOR (
        type: colorPicker
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 30
            region: @dialog-map-element
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P2_GEOJSON (
        type: textField
        label {
            label: Geojson
            alignment: left
        }
        layout {
            sequence: 20
            region: @dialog-map-element
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P2_TRAZADO_ID (
        type: popupLov
        label {
            label: Trazado Id
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @trazados-name
            nullDisplayValue: Seleccione Una
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button agregar-elemento (
        buttonName: AGREGAR_ELEMENTO
        label: Agregar Elemento
        layout {
            sequence: 20
            region: @dialog-maker-elment
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--link
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:agregar_elemento()
        }
    )

    button agregar-sitio (
        buttonName: AGREGAR_SITIO
        label: Agregar Sitio
        layout {
            sequence: 10
            region: @dialog-maker-elment
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--link
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:open_buscar_sitio()
        }
    )

    dynamicAction new (
        name: REFRESCAR_MAPA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P2_TRAZADO_ID
        }

        action native-javascript-code (
            name: encuadrarMapa
            action: executeJsCode
            settings {
                jsCode: encuadrarTrazado("MAPA-GL");
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            name: refrescarMapa
            action: refresh
            affectedElements {
                selectionType: region
                region: @mapa-gl
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction preparar-encuadre (
        name: PREPARAR_ENCUADRE
        execution {
            sequence: 20
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @mapa-gl
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    
                    /*
                    const region = apex.region("MAPA-GL");
                    // Registrar antes del refresh y evitar manejadores duplicados.
                    region.element.off("apexafterrefresh.encuadrarTrazado")
                        .one("apexafterrefresh.encuadrarTrazado", function () {
                            const bbox = region.mapData?.map?.bbox;
                            const map = region.getMapObject();
                            if (!map || !Array.isArray(bbox)) {
                                return;
                            }
                            // Coordenadas WGS 84: longitud, latitud; sin transformacion.
                            const coordinates = bbox.flat();
                            if (coordinates.length !== 4 ||
                                !coordinates.every(Number.isFinite)) {
                                return;
                            }
                            const [west, south, east, north] = coordinates;
                            if (west < -180 || east > 180 || west > east ||
                                south < -90 || north > 90 || south > north) {
                                return;
                            }
                            map.fitBounds([[west, south], [east, north]], {
                                padding: 40,
                                maxZoom: 16,
                                duration: 700,
                                bearing: map.getBearing()
                            });
                        });
                    */
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

