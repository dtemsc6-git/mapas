        layer elementos (
            name: ELEMENTOS
            layout {
                sequence: 70
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select id,
                           fo_id,
                           capacidad,
                           ubicacion,
                           tipo_material,
                           lon,
                           lat,
                           tipo_elemento,
                           el.display_value as elemento,
                           reserva_mts,
                           cod_columna,
                           comentarios
                      from sgt_ceo_elementos
                      join (select return_value,
                             display_value
                              from apex_application_lov_entries
                             where application_id = :app_id
                               and list_of_values_name = 'CEO_TIPO_ELEMENTO') el
                        on el.return_value = nvl(to_char(tipo_elemento), '1')
                    
                        where (:P3_FO_ID IS NULL OR fo_id = :P3_FO_ID)
                    ```
                pageItemsToSubmit: P3_FO_ID
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LON
                latitudeColumn: LAT
            }
            pointObjects {
                shape: Square
            }
            tooltip {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    Tipo de Elemento: &ELEMENTO. <br/>
                    Reserva: &RESERVA.<br/>
                    Ubicación: &UBICACION. <br/>
                    Capacidad: &CAPACIDAD. <br/>
                    Material: &TIPO_MATERIAL.<br/>
                    Comentarios: &COMENTARIOS. <br/>
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 8
                    items: {
                        P8_ID: &ID.
                    }
                }
            }
        )

        layer eventos (
            name: EVENTOS
            layout {
                sequence: 80
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    /*
                    Lovs:
                    --EVENTOS_TIPO
                    --EVENTOS_ESTADOS
                    */
                    
                    select ID,
                           FO_ID,
                           lov_tipo.display_value DISPLAY_TIPO_EVENTO,
                           TIPO_FALLA,
                           ESTADO,
                           CRITICIDAD,
                           LON,
                           LAT,
                           FECHA_INICIO,
                           FECHA_FIN,
                           CREADO_POR,
                           CREADO_EL,
                           MODIFICADO_POR,
                           MODIFICADO_EL,
                           COMENTARIOS
                      from SGT_EVENTOS_FO
                       
                       join  apex_application_lov_entries lov_tipo on lov_tipo.return_value = TIPO_EVENTO
                    
                    
                     WHERE APPLICATION_ID = :APP_ID 
                       AND LIST_OF_VALUES_NAME = 'EVENTOS_TIPO'
                       and estado = 1
                       and (:P3_FO_ID IS NULL OR fo_id = :P3_FO_ID)
                    ```
                pageItemsToSubmit: P3_FO_ID
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LON
                latitudeColumn: LAT
                primaryKeyColumn: ID
            }
            pointObjects {
                shape: Square Alternative
            }
            appearance {
                fillColor: #f01111
            }
            tooltip {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    Tipo Evento: &DISPLAY_TIPO_EVENTO. <br/>
                    Tipo Falla: &TIPO_FALLA.<br/>
                    Crticidad: &CRITICIDAD.<br/>
                    Comentarios: &COMENTARIOS. <br/>
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 10
                    items: {
                        P10_ID: &ID.
                    }
                }
            }
        )

