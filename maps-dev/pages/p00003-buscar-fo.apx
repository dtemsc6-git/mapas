        layer armored (
            name: ARMORED
            layerType: lines
            label {
                label: Armored
            }
            layout {
                sequence: 30
            }
            source {
                location: regionSource
                useSpatialIndex: true
            }
            rowAssignment {
                column: FILTRO_CABLE
                valueForThisLayer: ARMORED
            }
            columnMapping {
                geometryColumn: SDO_DATA
                primaryKeyColumn: FO_ID
            }
            appearance {
                strokeColor: #c99916
            }
            tooltip {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    <b>FO: </b>&NOMBRE.<br/>
                    <b>Nombre: </b>&L_NAME. <br/>
                    <b>Descripción: </b>&L_DESC. <br/>
                    <b>Cantidad de FO: </b>&CANTIDAD_DE_PELOS.
                    <b>Tipo Cable: </b>&TIPO_CABLE.
                    <b>Certificación: </b>&CERT. Km <br/>
                    <b>Servicios: </b>&SERVICIOS.
                    <b>Enlaces WAN: </b>&ENLACES_WAN.
                    ```
            }
            link {
                type: redirectUrl
                targetUrl: javascript:setFoId('&FO_ID.')
            }
        )

