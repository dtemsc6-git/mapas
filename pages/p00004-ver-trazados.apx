    dynamicAction new_1 (
        name: ANALIZAR_GEOJSON
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P4_GEOJSON
        }

        action native-javascript-code (
            name: COORD_DUPLICADAS
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /**
                     * Analiza un GeoJSON o un array de coordenadas en busca de puntos duplicados o similares.
                     * @param {Object|Array} geojson - Objeto GeoJSON (FeatureCollection, Feature, Geometry) o un Array de [x, y, z].
                     * @param {number} tol - Tolerancia en grados (~0.000001 ≈ 0.1 metros; 0 para coincidencia exacta).
                     * 
                     * La idea ahora es partir una linea en lineas más manejables cuando la cantidad de vertices supere un cierto umbral
                     * Supongamos 300 coordenadas por lineas, entonces generar nuevos features por cada linea adicional
                     * Las propiedades se compartiran.
                    */
                    function analizarCoordenadasDuplicadas(geojson, tol = 0.0005) {
                        let coords = [];
                        // Extract de coordenadas según el tipo de estructura GeoJSON
                        if (Array.isArray(geojson)) {
                            coords = geojson;
                        } else if (geojson.type === 'FeatureCollection') {
                            geojson.features.forEach(f => {
                                if (f.geometry && f.geometry.coordinates) {
                                    coords = coords.concat(f.geometry.coordinates);
                                }
                            });
                        } else if (geojson.type === 'Feature') {
                            coords = geojson.geometry.coordinates;
                        } else if (geojson.coordinates) {
                            coords = geojson.coordinates;
                        }
                    
                        console.log(`Total de puntos analizados: ${coords.length}`);
                    
                        const indicesAEliminar = new Set();
                        const duplicadosConsecutivos = [];
                        const duplicadosGlobales = [];
                    
                        for (let i = 0; i < coords.length; i++) {
                            const [x1, y1] = coords[i];
                            // 1. Detección de duplicados CONSECUTIVOS (Punto A_i idéntico o muy cercano al Punto A_i+1)
                            // Esto es lo que más corrompe las LineStrings en SDO_UTIL.FROM_GEOJSON
                            if (i < coords.length - 1) {
                                const [x2, y2] = coords[i + 1];
                                const dist2D = Math.hypot(x1 - x2, y1 - y2);
                    
                                if (dist2D <= tol) {
                                    duplicadosConsecutivos.push({
                                        indiceA: i,
                                        indiceB: i + 1,
                                        distanciaGrados: dist2D,
                                        puntoA: coords[i],
                                        puntoB: coords[i + 1],
                                        esExacto: dist2D === 0
                                    });
                    
                                }
                            }
                            // 2. Detección de duplicados GLOBALES (El mismo punto repetido en cualquier otra parte del trazado)
                            // Si el punto i ya fue marcado para eliminar omitir compararlo
                            if (indicesAEliminar.has(i)) continue;
                            for (let j = i + 1; j < coords.length; j++) {
                                const [x2, y2] = coords[j];
                                const dist2D = Math.hypot(x1 - x2, y1 - y2);
                    
                                if (dist2D <= tol && j !== i + 1) {
                                    duplicadosGlobales.push({
                                        indiceOriginal: i,
                                        indiceDuplicado: j,
                                        distanciaGrados: dist2D,
                                        punto: coords[i]
                                    });
                                    indicesAEliminar.add(j);
                                }
                            }
                        }
                        // Reporte en Consola
                        console.group('--- RESULTADOS DEL ANÁLISIS ---');
                    
                        // Filtrar la lista original excluyendo los índices duplicados
                        const coordsLimpias = coords.filter((_, index) => !indicesAEliminar.has(index));
                        
                        console.warn(`Puntos Duplicados/Similares CONSECUTIVOS: ${duplicadosConsecutivos.length}`);
                        if (duplicadosConsecutivos.length > 0) {
                            console.table(duplicadosConsecutivos);
                        }
                    
                        console.warn(`Puntos Duplicados GLOBALES (Cruces/Lazos): ${duplicadosGlobales.length}`);
                        if (duplicadosGlobales.length > 0) {
                            console.table(duplicadosGlobales);
                        }
                        console.groupEnd();
                        return coordsLimpias;
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

        action native-javascript-code_1 (
            name: DIVIDIR_JSON
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /**
                     * Divide un GeoJSON LineString o arreglo de coordenadas en múltiples LineStrings
                     * con un tamaño máximo especificado por segmento.
                     * 
                     * @param {Object|Array} geojson - GeoJSON o Array de coordenadas [[x,y], ...]
                     * @param {number} maxPuntos - Tamaño máximo de vértices por segmento (por defecto 300)
                     * @returns {Object} FeatureCollection con las LineStrings divididas
                     */
                    function dividirLineString(geojson, maxPuntos = 300) {
                        let coords = [];
                        let propiedades = {};
                    
                        // 1. Extraer coordenadas y propiedades del objeto de entrada
                        if (Array.isArray(geojson)) {
                            coords = geojson;
                        } else if (geojson.type === 'FeatureCollection') {
                            geojson.features.forEach(f => {
                                if (f.geometry && f.geometry.coordinates) {
                                    coords = coords.concat(f.geometry.coordinates);
                                }
                            });
                            if (geojson.features[0]?.properties) {
                                propiedades = geojson.features[0].properties;
                            }
                        } else if (geojson.type === 'Feature') {
                            coords = geojson.geometry?.coordinates || [];
                            propiedades = geojson.properties || {};
                        } else if (geojson.coordinates) {
                            coords = geojson.coordinates;
                        }
                    
                        if (coords.length === 0) {
                            console.warn('No se encontraron coordenadas para procesar.');
                            return null;
                        }
                    
                        const featuresDivididos = [];
                        let inicio = 0;
                    
                        // 2. Fragmentar en bloques de máximo 'maxPuntos'
                        while (inicio < coords.length) {
                            // Tomamos desde 'inicio' hasta 'inicio + maxPuntos'
                            // El solapamiento (+1) asegura continuidad geográfica entre líneas consecutivas
                            let fin = inicio + maxPuntos;
                            
                            // Si no es el primer segmento, incluimos el último punto del segmento anterior
                            let segmento = coords.slice(inicio > 0 ? inicio - 1 : inicio, fin);
                    
                            if (segmento.length >= 2) {
                                featuresDivididos.push({
                                    type: 'Feature',
                                    properties: {
                                        ...propiedades,
                                        segmento_index: featuresDivididos.length + 1,
                                        total_puntos: segmento.length
                                    },
                                    geometry: {
                                        type: 'LineString',
                                        coordinates: segmento
                                    }
                                });
                            }
                    
                            // Si ya procesamos todo el arreglo, salimos
                            if (fin >= coords.length) break;
                            
                            inicio = fin;
                        }
                    
                        console.log(`Línea original con ${coords.length} puntos dividida en ${featuresDivididos.length} segmento(s).`);
                    
                        // 3. Devolver como FeatureCollection
                        return {
                            type: 'FeatureCollection',
                            features: featuresDivididos
                        };
                    }
                    
                    $s('P4_RESULTADO_SIN_DUP', JSON.stringify(dividirLineString(JSON.parse($v('P4_GEOJSON')), 300)))
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action redondear-coordenadas (
            name: REMOVER_ALTITUD
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function limitarDecimalesGeoJSON(geojson, maxDecimales = 6) {
                      const factor = Math.pow(10, maxDecimales);
                    
                      // Redondea un número individual a máximo 'maxDecimales'
                      function truncar(num) {
                        
                          return Math.round((num * factor)) / factor;
                      }
                    
                      // Recorre arrays recursivamente para llegar al par [longitud, latitud, (elevación)]
                      function procesarCoordenadas(coords) {
                        if (!Array.isArray(coords)) return coords;
                        if (typeof coords[0] === 'number') {
                          return coords.map(truncar);
                        }
                        return coords.map(procesarCoordenadas);
                      }
                    
                      // Recorre la estructura del objeto GeoJSON
                      function procesarObjeto(obj) {
                        if (!obj || typeof obj !== 'object') return obj;
                    
                        // Si es un clon profundo o un nuevo objeto
                        const copia = Array.isArray(obj) ? [] : { ...obj };
                    
                        if (copia.type === 'FeatureCollection' && Array.isArray(copia.features)) {
                            
                          copia.features = copia.features.map(procesarObjeto);
                        } else if (copia.type === 'Feature' && copia.geometry) {
                            
                          copia.geometry = procesarObjeto(copia.geometry);
                        } else if (copia.coordinates) {
                            
                          copia.coordinates = procesarCoordenadas(copia.coordinates);
                        }
                    
                        return copia;
                      }
                    
                      return procesarObjeto(geojson);
                    }
                    
                    
                    
                    
                    $s('P4_RESULTADO_SIN_DUP', JSON.stringify(limitarDecimalesGeoJSON(JSON.parse($v('P4_GEOJSON')))))
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

        action redondear-coordenadas_1 (
            name: REDONDEAR_COORDENADAS
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function limpiarGeoJSON(geojson, maxDecimales = 6) {
                      const numDecimales = Math.min(Math.max(0, maxDecimales), 15);
                      const factor = Math.pow(10, numDecimales);
                    
                      function truncar(num) {
                        if (typeof num !== 'number' || isNaN(num)) return num;
                        return Math.round((num + Number.EPSILON) * factor) / factor;
                      }
                    
                      function procesarCoordenadas(coords) {
                        if (!Array.isArray(coords)) return coords;
                        
                        // Si es un par/trío de números [lng, lat, alt]
                        if (typeof coords[0] === 'number') {
                          // slice(0, 2) remueve la altitud (tercer elemento) y solo conserva [lng, lat]
                          return coords.slice(0, 2).map(truncar);
                        }
                        
                        return coords.map(procesarCoordenadas);
                      }
                    
                      function procesarObjeto(obj) {
                        if (!obj || typeof obj !== 'object') return obj;
                    
                        const copia = Array.isArray(obj) ? [] : { ...obj };
                    
                        if (copia.type === 'FeatureCollection' && Array.isArray(copia.features)) {
                          copia.features = copia.features.map(procesarObjeto);
                        } else if (copia.type === 'Feature' && copia.geometry) {
                          copia.geometry = procesarObjeto(copia.geometry);
                        } else if (copia.type === 'GeometryCollection' && Array.isArray(copia.geometries)) {
                          copia.geometries = copia.geometries.map(procesarObjeto);
                        } else if (copia.coordinates) {
                          copia.coordinates = procesarCoordenadas(copia.coordinates);
                        }
                    
                        return copia;
                      }
                    
                      return procesarObjeto(geojson);
                    }
                    
                    // Ejecución en tu Acción Dinámica de APEX
                    let geojsonOriginal = JSON.parse($v('P4_GEOJSON'));
                    let geojsonLimpio = limpiarGeoJSON(geojsonOriginal, 6);
                    
                    $s('P4_RESULTADO_SIN_DUP', JSON.stringify(geojsonLimpio));
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

    )

