    process check-trazado (
        name: CHECK_TRAZADO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /*
                Chequear si ya existe un trazad en la db de un enlace dado.
                */
                
                declare
                v_id integer;
                --chequea la existencia del trazado
                v_existe NUMBER(1);
                
                begin
                
                --Buscar el id del trazado
                select pk_id into v_id from sgt_archivos
                where id = :P4_ARCHIVOS_KMZ;
                
                --buscar en la db si ya hay un trazado
                --2026-10-21: CAMBIO PARA CHEQUEAR EN SGT_TRAZADOS_FO
                SELECT CASE 
                           WHEN EXISTS (SELECT 1 FROM sgt_trazadoS_fo WHERE fo_id = v_id) THEN 1 
                           ELSE 0 
                         END
                  INTO v_existe
                  FROM dual;
                
                 
                 --No existen registros se puede guardar
                 if v_existe = 0 then 
                    apex_json.open_object;
                    apex_json.write('success', true);
                    apex_json.write('guardar', 'ok');
                    apex_json.close_object;
                 end if;
                 
                end;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 10418211657306106
        }
    )

