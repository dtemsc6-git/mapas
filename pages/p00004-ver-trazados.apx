                ```plsql
                /*
                Obtener un trazado y cargar los datos en la tabla de trazados.
                */
                declare
                v_id integer := 0;
                
                --Declarar el cursor que se utilizara
                Cursor c_geojson is (SELECT v_id AS ID, jt.type as type, JT.l_name, JT.l_desc,  sdo_util.from_GEOJSON(jt.geometry) AS geom
                FROM 
                     JSON_TABLE(
                        :P4_GEOJSON, 
