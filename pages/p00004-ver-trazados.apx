    process get-kmz (
        name: GET_KMZ
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_blob          BLOB;
                    l_filename      varchar2(4000);
                    l_file_mimetype varchar2(4000);
                    l_base64        CLOB;
                BEGIN
                    -- Obtener el KMZ de tu tabla
                    SELECT file_blob, file_name, file_mimetype INTO l_blob , l_filename, l_file_mimetype
                    FROM  SGT_ARCHIVOS 
                    WHERE ID =:P4_ARCHIVOS_KMZ ;
                    
                
                    -- Convertir a Base64
                    
                    l_base64 := APEX_WEB_SERVICE.BLOB2CLOBBASE64(
                        p_blob => l_blob,
                        p_newlines => 'N',
                        p_padding => 'Y'
                    );
                    
                    -- Retornar JSON
                    apex_json.open_object;
                    apex_json.write('success', true);
                    apex_json.write('fileName', l_filename);
                    apex_json.write('mimetype', l_file_mimetype);
                    apex_json.write('kmz_data', l_base64);
                    apex_json.close_object;
                    
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        apex_json.open_object;
                        apex_json.write('kmz_data');
                        apex_json.close_object;
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 10099312364987846
        }
    )

    process get-trazado (
        name: GET_TRAZADO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /*
                Se trato de convertir el archivo KMZ a uno o varios objetos SDO_GEOMETRY, esta en prueba aún.
                No utilizar esta funcion aún.
                */
                
                
                DECLARE
                    l_kmz          BLOB;
                    l_kml_blob     BLOB;
                    l_kml_clob     CLOB;
                    
                    l_entries      apex_zip.t_dir_entries;
                    l_file_path    VARCHAR2(32767);
                    
                    -- Variables para la conversión JSON -> SDO
                    l_geojson_str  CLOB;
                    geom_result    SDO_GEOMETRY;
                    val_result     VARCHAR2(100);
                    
                    -- Variables auxiliares para formatear el texto
                    l_coord_clean  CLOB;
                    
                    -- Variables para la conversión de BLOB a CLOB
                    l_dest_offset  INTEGER := 1;
                    l_src_offset   INTEGER := 1;
                    l_lang_ctx     INTEGER := DBMS_LOB.default_lang_ctx;
                    l_warning      INTEGER;
                BEGIN
                    -- 1. Obtener el archivo KMZ
                    SELECT file_blob INTO l_kmz FROM sgt_archivos WHERE id = :P4_SELECCION;
                
                    -- 2. Leer entradas del zip
                    l_entries := apex_zip.get_dir_entries(p_zipped_blob => l_kmz, p_only_files => true);
                    l_file_path := l_entries.first;
                
                    WHILE l_file_path IS NOT NULL LOOP
                        IF lower(l_file_path) LIKE '%.kml' THEN
                            l_kml_blob := apex_zip.get_file_content(p_zipped_blob => l_kmz, p_dir_entry => l_entries(l_file_path));
                            
                            DBMS_LOB.CREATETEMPORARY(l_kml_clob, TRUE);
                            l_dest_offset := 1; l_src_offset := 1;
                            
                            DBMS_LOB.CONVERTTOCLOB(
                                dest_lob => l_kml_clob, src_blob => l_kml_blob, amount => DBMS_LOB.LOBMAXSIZE,
                                dest_offset => l_dest_offset, src_offset => l_src_offset,
                                blob_csid => DBMS_LOB.default_csid, lang_context => l_lang_ctx, warning => l_warning
                            );
                
                            -- 3. EXTRACCIÓN GLOBAL Y CONVERSIÓN A  FeatureCollection (GeoJSON)
                            BEGIN
                                -- Extraemos todas las geometrías en un objeto contenedor FeatureCollection
                                SELECT JSON_OBJECT(
                           'type'     VALUE 'FeatureCollection',
                           'features' VALUE JSON_ARRAYAGG(
                                            JSON_OBJECT(
                                                'type'     VALUE 'Feature',
                                                'geometry' VALUE JSON_OBJECT(
                                                                'type'        VALUE x.geom_type,
                                                                'coordinates' VALUE treat (x.coord_json  as json)
                                                             )
                                            )
                                        )
                       )
                INTO l_geojson_str
                FROM (
                    SELECT 
                        geom_type,
                        CASE geom_type
                            -- Point: Convierte "X,Y" en [X, Y]
                            WHEN 'Point' THEN 
                                '[' || REGEXP_REPLACE(TRIM(coord_raw), ',[^, ]+( |$)', '\1') || ']'
                            -- LineString: Convierte "X1,Y1 X2,Y2" en [[X1,Y1],[X2,Y2]]
                            WHEN 'LineString' THEN 
                                '[[' || REPLACE(REGEXP_REPLACE(coord_raw, ',[^, ]+( |$)', '\1'), ' ', '],[') || ']]'
                        END AS coord_json
                    FROM XMLTABLE(
                        '//*[local-name()="Point" or local-name()="LineString"]'
                        PASSING XMLTYPE(l_kml_clob)
                        COLUMNS 
                            geom_type VARCHAR2(30) PATH 'local-name(.)',
                            coord_raw CLOB         PATH '*[local-name()="coordinates"]'
                    )
                ) x;
                
                                -- Aseguramos el reemplazo de espacios por comas para cumplir con la sintaxis exacta de JSON arrays
                                 --l_geojson_str := REPLACE(l_geojson_str, '] [', '],[');
                                --Mostrar el json
                                 DBMS_OUTPUT.PUT_LINE('--- Ver Json ---');
                                 DBMS_OUTPUT.PUT_LINE(l_geojson_str);
                                 --Hacer la consulta del JSON table para seleccionar los Puntos
                                 --Hacer la consulta del json table para seleccionar los Puntos
                                -- 4. CONVERTIR EL JSON MULTI-GEOMETRÍA A SDO_GEOMETRY
                               -- geom_result := SDO_UTIL.FROM_JSON(l_geojson_str);
                
                                /* 
                                IF geom_result IS NOT NULL THEN
                                    geom_result.SDO_SRID := 4326; -- Forzar WGS84
                                    val_result := SDO_GEOM.VALIDATE_GEOMETRY_WITH_CONTEXT(geom_result, 0.005);
                                    
                                    DBMS_OUTPUT.PUT_LINE('--- Conversión Exitosa (Múltiples Geometrías) ---');
                                    DBMS_OUTPUT.PUT_LINE('Archivo: ' || l_file_path);
                                    DBMS_OUTPUT.PUT_LINE('Tipo SDO resultante: ' || geom_result.SDO_GTYPE);
                                    DBMS_OUTPUT.PUT_LINE('Validación Espacial: ' || val_result);
                                ELSE
                                    DBMS_OUTPUT.PUT_LINE('Error: SDO_UTIL.FROM_JSON retornó NULL al procesar la colección.');
                                END IF;
                                */
                
                            EXCEPTION
                                WHEN OTHERS THEN
                                    DBMS_OUTPUT.PUT_LINE('Error procesando el formato: ' || SQLERRM);
                                    DBMS_LOB.FREETEMPORARY(l_kml_clob);
                            END;
                
                            DBMS_LOB.FREETEMPORARY(l_kml_clob);
                        END IF;
                        l_file_path := l_entries.next(l_file_path);
                    END LOOP;
                       APEX_JSON.OPEN_OBJECT;
                       APEX_JSON.WRITE('data',l_geojson_str); -- Convierte el cursor a JSON array
                       APEX_JSON.CLOSE_OBJECT;
                    
                     
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 10097366735987826
        }
    )

    process save-bucle-trazado (
        name: SAVE_BUCLE_TRAZADO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /*
                Obtener un trazado y cargar los datos en la tabla de trazados.
                El parametro 4326 es el SRID definido por defecto para esta app.
                Por alguna razon oracle sdo_util setea por defecto el 4327, al comienzo me creo el indice por defecto en ese sistema
                voy a averiguar cual es el sistema predefinido para utlizarlo como es predefinido por ORACLE.
                */
                declare
                v_id integer := 0;
                returned_json CLOB;
                
                --Declarar el cursor que se utilizara
                Cursor c_geojson is (SELECT v_id AS ID, jt.type as type, JT.l_name, JT.l_desc,  sdo_util.from_GEOJSON(jt.geometry, NULL ,4326) AS geom
                FROM 
                     JSON_TABLE(
                        :P4_GEOJSON, 
                       '$.features[*]'
                       COLUMNS (
                         type path '$.geometry.type',
                         geometry clob format json PATH '$.geometry',
                         l_name path '$.properties.name',
                         l_desc path '$.properties.description'
                       )
                     ) jt);
                
                json_error EXCEPTION;
                DIM_ERROR EXCEPTION;
                SRID_ERROR EXCEPTION;
                PRAGMA EXCEPTION_INIT(json_error, -40441);
                PRAGMA EXCEPTION_INIT(SRID_ERROR, -29875);
                --PRAGMA EXCEPTION_INIT(, -40441);
                
                begin
                
                select pk_id into v_id from sgt_archivos where id = :P4_ARCHIVOS_KMZ;
                
                -- no encontro el enlace lanzar un error
                IF (v_id = 0) then
                   RAISE_APPLICATION_ERROR(-20001, 'No se encontró el enlace especificado.');
                end if;   
                
                
                --para evitar duplicados limpiar todos los datos relacionados a este v_id
                -- No implementado aún
                
                --iterar los datos
                
                
                
                FOR REC IN c_geojson LOOP
                
                returned_json := SDO_UTIL.TO_GEOJSON(REC.geom);
                --2026-10-21 Cambio para insertar en SGT_TRAZADOS_FO
                INSERT INTO SGT_TRAZADOS_FO (FO_ID, TYPE ,L_NAME, L_DESC, SDO_DATA)
                
                VALUES (V_ID, REC.TYPE, REC.l_NAME, REC.L_DESC, REC.geom);
                
                
                
                END LOOP;
                
                
                
                --apex.debug
                
                apex_json.open_object; 
                apex_json.write('success', true);
                apex_json.write('RegistrosInsertados', SQL%ROWCOUNT);
                apex_json.write('returned_json', returned_json);
                apex_json.close_object;
                
                EXCEPTION
                   when json_error THEN
                        apex_json.open_object; 
                        apex_json.write('geo_json', LENGTH(:P4_GEOJSON ));
                        apex_json.write('sql_error', SQLERRM);
                        apex_json.write('error', true);
                        apex_json.close_object;  
                   
                    when SRID_ERROR THEN
                        apex_json.open_object; 
                        apex_json.write('error', 'Error de dimensionalidad o SRID:');
                        apex_json.write('sql_error', SQLERRM);
                        apex_json.write('returned_json', returned_json);
                        apex_json.write('error', true);
                        apex_json.close_object;         
                   
                end;
                ```
        }
        execution {
            sequence: 50
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 10419711690306121
        }
    )

