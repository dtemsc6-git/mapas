        action check-trazado (
            name: Check trazado
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    guardar = function() {
                        //Para evitar la doble conversion
                                
                                    apex.server.process('SAVE_BUCLE_TRAZADO', { pageItems : ['P4_ARCHIVOS_KMZ', 'P4_GEOJSON'] }, 
                                        {
                                            success: function(data) {
                                                console.log("SAVE_BUCLE_TRAZADO: Success", data);
                                                apex.message.showPageSuccess( "Trazado generado!!!..." );
                                                                      },
                                            error: function(error) {
                                                console.log("SAVE_BUCLE_TRAZADO: Error", error);
                                                apex.message.clearErrors(); 
                                                apex.message.showErrors ( [ 
                                                    { type: "error", location: [ "page", "inline" ], pageItem: "P4_GEOJSON", message: "error en el json!", unsafe: false }, { type: "error", location: "page", message: 'Ver datos', unsafe: false } 
                                                    ] );
                                            }
                                        }
                                    )
                                 
                    }
                    
                    apex.server.process(
                            'CHECK_TRAZADO', { pageItems: ['P4_ARCHIVOS_KMZ'] },
                            {
                                success: function (data) {
                    
                                    console.log("CHECK_TRAZADO: Resultado de la petición:", data);
                                    guardar();
                                    
                                },
                                error: function (error) {
                                    console.log("CHECK_TRAZADO: Se produjo un error:");
                                    console.log(error);
                                    apex.message.confirm("Se encontro un trazado, desea remplazarlo?",  function(okPressed) {if (okPressed ) {guardar()}}, {title: "Ya existen un trazado", style: "warning",confirmLabel: "Remplazar?"} )
                                }
                            }
                        );
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

