    dynamicAction setear-valores (
        name: setear valores
        execution {
            sequence: 20
        }
        when {
            event: focusout
            selectionType: items
            items: P3_URL
        }

        action native-javascript-code (
            name: extraer_lat_long
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //
                    url = this.triggeringElement.value;
                    let m = url.match(/[?&]q=(-?\d+\.?\d*)(?:%2C|,)(-?\d+\.?\d*)/i);
                    
                    //Si hay m parseo las latitudes, si no, la url esta mál
                    let data = {};
                    if (m) {
                        $s("P3_LAT", m[1]);
                        $s("P3_LONG", m[2]);
                        punto = { "type": "Point", "coordinates": m }
                        $s("P3_CLICK_POSICION", JSON.stringify(punto))
                        data.lng = m[2], data.lat = m[1]
                        centrarMapa( data );   
                        return;
                    }
                    
                    // Formato /@lat,lng
                    m = url.match(/@(-?\d+\.?\d*),(-?\d+\.?\d*)/);
                    console.log("M es:", m);
                    if (m) {
                        $s("P3_LAT", m[1]); $s("P3_LONG", m[2]);
                    
                        punto = { "type": "Point", "coordinates": [m[2],m[1]] }
                        $s("P3_CLICK_POSICION", JSON.stringify(punto))
                        data.lng = m[2], data.lat = m[1]
                        centrarMapa( data );   
                        return;
                    };
                    
                    $s("P3_LAT", "");
                    $s("P3_LONG", "");
                    ```
            }
            affectedElements {
                selectionType: items
                items: P3_POR_LAT_LONG
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process guardar-fo-id (
        name: SET_FO_ID
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                APEX_UTIL.SET_SESSION_STATE('P3_FO_ID', :P3_FO_ID);
                
                apex_json.open_object();
                apex_json.write('success', true );
                apex_json.close_object();
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 11127462784761221
        }
    )

)

