            sequence: 60
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
    )

    region mensaje (
        name: Mensaje
        type: staticContent
        source {
            htmlCode: No se selecciono un trazado
        }
        layout {
            sequence: 30
            parentRegion: @new_2
            slot: regionBody
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
                js-headingLevel-3
            ]
        }
    )

    region new (
        name: enlaces_fo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EF.ID,
                       NOMBRE,
                       SITIO_ID_A,
                       EQUIPO_ID_A,
                       SITIO_ID_B,
                       EQUIPO_ID_B,
                       "CERTIFICACIÓN",
                       UNIDAD_MEDIDA,
                       ABS_LONGITUD,
                       CANTIDAD_DE_PELOS,
                       TIPO_DE_FO,
                       TIPO,
                       LT,
                       CONECTOR,
                       ESTADO,
                       COMENTARIOS,
                       "PROYECTO_DE_IMPLEMENTACIÓN",
                       "FECHA_IMPLEMENTACIÓN",
                       UNIDAD_ENCARGADA_ACTUAL,
                       
                       TIPO_CABLE,
                       TIPO_TENDIDO,
                       PUERTOS_LADO_A,
                       PUERTOS_LADO_B, 
                       sdo_nn_distance( 1 ) as distance
                  from SGT_ENLACES_FO EF
                  JOIN SGT_TRAZADOS_FO2  TF ON EF.ID = TF.FO_ID
                  WHERE 
                
                  sdo_nn( TF.SDO_DATA , mdsys.sdo_util.from_geojson (:P3_CLICK_POSICION ), 'distance=2 unit=km',   1 ) = 'TRUE' 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        config {
            buildOption: @commented-out
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 10801688831897241
        }

