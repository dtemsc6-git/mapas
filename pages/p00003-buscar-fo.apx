page 3 (
    name: Buscar FO
    alias: BUSCAR-FO
    title: Buscar FO
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function centrarMapa(data) {
                console.log("centrarMapa: data",data)
                const { lng, lat } = data;
                 console.log("centrarMapa: long",lng);
                 console.log("centrarMapa: long",lat);
                apex.region("mapa-fo-ande").call( "getMapObject" ).flyTo({ 
                    center: [ lng, lat ],
                    screenSpeed: 0.7
                });
            }
            
            function setFoId( pFoId ) {
                console.log("setFoId", pFoId);
                $s("P3_FO_ID",pFoId);
                
                /*apex.server.process(
                'SET_FO_ID', { pageItems: ['P3_FO_ID'],  },
                {
                    success: function (data) {console.log("SET_FO_ID", data); },
            		error: function(error) {}
            	}
            	);
                */
                
            } 
            
            function abrirDialogo() {
                console.log("abrirDialog con FO_ID", $v("P3_FO_ID"));
                
                
              /*  var url = "f?p=" +
                $v("pFlowId") + ":" +
                "15:" +
                $v("pInstance") +
                "::NO::P_ID:123";
            
            apex.navigation.dialog(
                url,
                {
                    title: "Detalles",
                    height: "auto",
                    width: "800",
                    modal: true
                },
                "t-Dialog-page--standard"
            );
            */
            
                apex.theme.openRegion("dialogo-agregar");
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buscar-fo (
        name: Buscar FO
        type: map
        source {
            location: localDatabase
            tableName: SGT_TRAZADOS_FO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: mapa-fo-ande
        }
        map {
            background: builtIn
            standard: openstreetmapBright
        }
        controls {
            options: [
                mousewheelZoom
                scaleBar
                getBrowserLocation
                distanceTool
            ]
        }
        initialPositionAndZoom {
            type: staticValues
            longitude: -57.3332
            latitude: -25.3332
            zoomLevel: 6
        }
        attributes {
            messagesPosition: below
        }

        layer buscar-fo (
            name: CEOS
            label {
                label: CEO's
            }
            layout {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                geometryColumn: SDO_DATA
            }
            pointObjects {
                shape: Check
            }
            appearance {
                fillColor: #ffcc00
            }
            infoWindow {
                titleColumn: L_NAME
                bodyColumn: L_DESC
            }
        )

        layer elementos (
            name: ELEMENTOS
            layout {
                sequence: 40
            }
            source {
                tableName: SGT_CEO_ELEMENTOS
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LON
                latitudeColumn: LAT
            }
            pointObjects {
                shape: Square
            }
            pointClustering {
                enable: true
                shape: Default
            }
            tooltip {
                column: COMENTARIOS
            }
            link {
                type: redirectThisApp
                target: {
                    page: 8
                    items: {
                        P8_ID: &ID.
                    }
                }
            }
        )

        layer eventos (
            name: EVENTOS
            layout {
                sequence: 50
            }
            source {
                tableName: SGT_EVENTOS_FO
                whereClause: estado = 1
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LON
                latitudeColumn: LAT
                primaryKeyColumn: ID
            }
            pointObjects {
                shape: Square Alternative
            }
            appearance {
                fillColor: #f01111
            }
            pointClustering {
                enable: true
                shape: Flag Swallowtail
            }
            tooltip {
                column: COMENTARIOS
            }
            link {
                type: redirectThisApp
                target: {
                    page: 10
                    items: {
                        P10_ID: &ID.
                    }
                }
            }
        )

        layer new (
            name: TRAZADOS
            layerType: lines
            label {
                label: Trazados
            }
            layout {
                sequence: 20
            }
            source {
                location: regionSource
                useSpatialIndex: true
            }
            columnMapping {
                geometryColumn: SDO_DATA
                primaryKeyColumn: FO_ID
            }
            appearance {
                strokeColor: #4cd964
            }
            tooltip {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    <b>Nombre: </b>&L_NAME. <br/>
                    <b>Descripción: </b>&L_DESC.
                    ```
            }
            link {
                type: redirectUrl
                targetUrl: javascript:setFoId('&FO_ID.')
            }
        )

        layer posicion-click (
            name: PUNTO_CLICK
            label {
                label: Marcador
            }
            layout {
                sequence: 30
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 0 as id, mdsys.sdo_util.from_geojson( :P3_CLICK_POSICION) as geometry 
                      from sys.dual
                     where :P3_CLICK_POSICION is not null
                    ```
                pageItemsToSubmit: P3_CLICK_POSICION
            }
            columnMapping {
                geometryColumn: GEOMETRY
                primaryKeyColumn: ID
            }
            pointObjects {
                shape: Pin Circle
            }
            appearance {
                fillColor: #ff3b30
                strokeColor: #ff9500
            }
            link {
                type: redirectThisApp
                target: {
                    page: 5
                    items: {
                        P5_FO_ID: &P3_FO_ID.
                        P5_LAT: &P3_LAT.
                        P5_LNG: &P3_LONG.
                    }
                }
            }
        )

    )

    region dialogo-2 (
        name: dialogo_2
        type: staticContent
        source {
            htmlCode: Dialogo 2
        }
        layout {
            sequence: 50
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
    )

    region dialogo-3 (
        name: dialogo_3
