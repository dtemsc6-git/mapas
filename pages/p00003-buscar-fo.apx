    dynamicAction mapclick (
        name: MapClick
        execution {
            sequence: 30
        }
        when {
            event: region/map/spatialmapclick
            selectionType: region
            region: @buscar-fo
        }

        action abrirmodal_1 (
            name: SETEAR_DATOS
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    APEX_UTIL.SET_SESSION_STATE('P3_FO_ID', :P3_FO_ID);
                    APEX_UTIL.SET_SESSION_STATE('P3_LONG' , :P3_LONG);
                    APEX_UTIL.SET_SESSION_STATE('P3_LAT'  , :P3_LAT);
                    ```
                itemsToSubmit: [
                    P3_LONG
                    P3_LAT
                    P3_FO_ID
                ]
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /* const { lng, lat } = this.data;
                    
                    apex.region("mapa-fo-ande").call( "getMapObject" ).flyTo({ 
                        center: [ lng, lat ],
                        screenSpeed: 0.7
                    });
                    
                    */
                    
                    centrarMapa(this.data);
                    ```
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

        action native-javascript-code_1 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log("MapClick: ",this);
                    setFoId(null);
                    //obtener features cerca del click:
                    
                    
                    /*const features = apex.region("mapa-fo-ande").call( "getMapObject" ).queryRenderedFeatures(this.data);
                        if (features.length > 0) {
                            console.log('ID:', features[0].properties.id);
                        }
                    */
                     
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value_1 (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: "JSON.stringify({ \"type\":\"Point\", \"coordinates\": [this.data.lng, this.data.lat]})"
            }
            affectedElements {
