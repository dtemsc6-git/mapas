page 1 (
    name: Home
    alias: HOME
    title: maps-dev
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function showFeature( pId ) {
                console.log("showFeature", pId);
               $s( "P1_EVENTO_ID", pId );
                apex.event.trigger( $("#eventos-map-region"), "refresh_and_center" );
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region chart-3 (
        name: Estado de Eventos
        type: chart
        layout {
            sequence: 20
            parentRegion: @collapsible
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series series-1 (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT lov.display_value AS label, 
                           COUNT(ID) AS value 
                       from apex_application_lov_entries lov  
                       join
                      
                       SGT_EVENTOS_FO ef on lov.return_value = ef.estado  
                    
                       WHERE APPLICATION_ID = :APP_ID 
                       AND LIST_OF_VALUES_NAME = 'EVENTOS_ESTADOS'
                     
                     GROUP BY lov.display_value;
                    
                    
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            link {
                type: redirectThisApp
                target: {
                    page: 1
                }
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
        )

    )

    region collapsible (
        name: Dashboard
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
    )

    region eventos (
        name: Causas de los Eventos
        type: chart
