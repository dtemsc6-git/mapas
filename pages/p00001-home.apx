    dynamicAction new (
        name: refresh_center
        execution {
            sequence: 30
        }
        when {
            event: custom
            customEvent: refresh_and_center
            selectionType: jQuerySelector
            jquerySelector: #eventos-map-region
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @eventos-map-region
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction showfeature (
        name: ShowFeature
        execution {
            sequence: 20
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @eventos-map-region
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log("showFeature", true);
                    
                    var lMapRegion   = apex.region("eventos-map-region"),
                        // important: Use the layer name exactly as specified in the "name" attribute in Page Designer
                        lLayerId     = lMapRegion.call("getLayerIdByName", "EVENTOS"),
                        lCurrentZoom = lMapRegion.call("getMapCenterAndZoomLevel").zoom,
                        leventoId    = apex.item("P1_EVENTO_ID").getValue(),
                        lFeature     = lMapRegion.call("getFeature", lLayerId, leventoId ),
                        lPosition;
                    
                       
                    
                    if ( lFeature.geometry ) {
                        lPosition    = lFeature.geometry.coordinates;
                            
                        // close all Info Windows, which might currently be open
                        lMapRegion.call( "closeAllInfoWindows" );
                    
                        // focus the map to the chosen feature
                        lMapRegion.call( "setCenter", lPosition );
                    
                        // if the current zoom level is below 8, zoom in. Otherwise do nothing.
                        if ( lCurrentZoom < 12 ) {
                            lMapRegion.call( "setZoomLevel", 12 );
                        }
                        setTimeout( function() {lMapRegion.call( "displayPopup", "infoWindow", lLayerId, leventoId.toString(), false )}, 500 );
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

