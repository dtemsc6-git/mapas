    region new_1 (
        name: TOTAL_FALLAS
        title: Top 5 con más fallas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COUNT (ID) Total,
                       FO_ID Fibra
                         from SGT_EVENTOS_FO
                
                         where SGT_EVENTOS_FO.estado = '1'
                
                  group by FO_ID
                ```
        }
        layout {
            sequence: 40
            parentRegion: @resumen-fallas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
