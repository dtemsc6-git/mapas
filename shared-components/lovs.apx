lov fo-afectacion-servicio (
    name: FO_AFECTACION_SERVICIO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT FO.ID RETURN_VALUE, SRV.SERVICIOS AS DISPLAY_VALUE 
            FROM SGT_ENLACES_FO FO
            JOIN (
                SELECT es.fo_id,
                       LISTAGG(DISTINCT s.nombre, ', ')
                         WITHIN GROUP (ORDER BY s.nombre) servicios
                FROM sgt_equipos_servicio es
                JOIN sgt_servicios s
                  ON s.id = es.servicio_id
                GROUP BY es.fo_id
            ) srv ON srv.fo_id = FO.id
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

lov fo-afectacion-wan (
    name: FO_AFECTACION_WAN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT FO.ID RETURN_VALUE, WAN.enlaces_wan DISPLAY_VALUE
            FROM SGT_ENLACES_FO FO
            
            JOIN (
                SELECT ew.fo_id,
                       LISTAGG(DISTINCT w.nombre, ', ')
                         WITHIN GROUP (ORDER BY w.nombre) enlaces_wan
                FROM sgt_equipos_wan ew
                JOIN sgt_enlaces_wan w
                  ON w.id = ew.wan_id
                GROUP BY ew.fo_id
            ) wan ON wan.fo_id = FO.id
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

