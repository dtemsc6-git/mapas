/* 
Comma separated list of predicates to be fine-tuned for individual project. 
Run 
       project export -debug 
to double check the dictionary queries 
with internal and custom filters applied. 

Reference list of export_types from internal.fixed.filters 
        'ALL_OBJECTS',
        'ALL_INDEXES',
        'ALL_TRIGGERS',
        'ALL_SYNONYMS',
        'ALL_COL_COMMENTS',
        'ALL_TAB_COMMENTS',
        'USER_ROLE_PRIVS',
        'USER_SYS_PRIVS',
        'ALL_TAB_PRIVS',
        'ALL_MVIEW_LOGS',
        'ALL_QUEUE_TABLES',
        'ALL_QUEUES',
        'ALL_DEPENDENCIES',
        'APEX_APPLICATIONS', 
        'ORDS_SCHEMA',
        'APEX',
        'TABLES_DML',
        'USER',
        'DBA_ROLES'
*/    

     SUBOBJECT_NAME is null,
/*   ^^^^^^^^^^^^^^^^^^^^^^
     select distinct object_type from dba_objects 
     where subobject_name is not null;                           
     OBJECT_TYPE            
     -----------------------
     TABLE PARTITION
     INDEX PARTITION
     LOB PARTITION
     TYPE
     TABLE SUBPARTITION
     INDEX SUBPARTITION
     JAVA RESOURCE
     JAVA CLASS
     JAVA DATA
*/


-- Liquibase Tables
object_type != 'TABLE' or object_name not in ('DATABASECHANGELOG',
                                              'DATABASECHANGELOGLOCK',
                                              'DATABASECHANGELOG_ACTIONS'
                                              ),
not (object_type = 'VIEW'    and object_name ='DATABASECHANGELOG_DETAILS'),
not (object_type = 'TRIGGER' and object_name ='DATABASECHANGELOG_ACTIONS_TRG'),
not (object_type = 'INDEX' and object_name ='DATABASECHANGELOG_ACTIONS_PK'),


-- DM generated tables
--not (object_type = 'TABLE' and object_name like 'DM$%' ),
--not (object_type = 'VIEW' and object_name like 'DM$V%' ),
object_name not like 'DM$%',      -- covers tables, views, indexes 
object_name not like 'I_MLOG$%',      -- covers Materialized Views Logs Indexes
object_name not like 'I_SNAP$%',

--Tablas presentes en el schema de dte_Sc, que no forman parte del proyecto.
--object_name not like '%DBTOOL%',
--object_name not like '%HTMLDB%',
--object_name not like '%MDRT_%',
--object_name not like 'TEST_%',
--object_name not like '%AUDIT_%',


--Tablas que forman parte del proyecto.
  
( object_name in (
        'SGT_ENLACES_FO',
        'SGT_TRAZADOS_FO',
        'SGT_CEO_ELEMENTOS',
        'SGT_EVENTOS_FO'
) 
or upper(object_name) like 'CEO\_ELEMENTOS%' escape '\'
or upper(object_name) like 'EVENTOS\_FO\_ST%' escape '\'
or upper(object_name) like 'SGT\_ENLACES\_FO\_T%' escape '\'
),


--Agregado 'ORDS_SCHEMA' para que no genere datos de ORDS
export_type not in ('USER_SYS_PRIVS','USER_ROLE_PRIVS','USER','ALL_USERS','DBA_ROLES', 'ORDS_SCHEMA'),

-- Exclude certain database object types:
-- object_type not in ('CONTEXT', 'SCHEDULE'),         

-- Export APEX application only:
-- export_type = 'APEX_APPLICATIONS',

-- Export applications 200 and 300:
application_id in (112),

-- More APEX filters:
-- is_working_copy = 'Yes', -- Yes/No
-- main_application_id is null, -- if this has a value then it's WC
------------------------------^ The final trailing comma is optional
